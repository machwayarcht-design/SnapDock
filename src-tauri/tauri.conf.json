{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapDock",
  "version": "1.7.1",
  "identifier": "com.snapdock.app",
  "build": {
    "beforeDevCommand": "echo dev",
    "beforeBuildCommand": "echo build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SnapDock",
        "width": 420,
        "height": 320,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
